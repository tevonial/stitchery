{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "[api] debug",
            "presentation": {
                "group": "services",
                "order": 1
            },
            "type": "node",
            "request": "attach",
            "remoteRoot": "/app",
            "localRoot": "${workspaceFolder}/stitchery-api",
            "preLaunchTask": "docker-compose: api",
            "autoAttachChildProcesses": true,
            "smartStep": true,
            "skipFiles": [
                "${workspaceFolder}/**/node_modules/**/*.js"
            ],
            "continueOnAttach": true,
            "restart": true
        },
        {
            "name": "[api] docker debug",
            "presentation": {
                "hidden": true,
                "group": "services",
                "order": 2
            },
            "type": "docker",
            "request": "launch",
            "preLaunchTask": "docker-compose: api",
            "platform": "node",
        },
        {
            "name": "[frontend] browser",
            "presentation": {
                "group": "services",
                "order": 2
            },
            "type": "editor-browser",
            "request": "launch",
            "preLaunchTask": "docker-compose: frontend",
            "url": "https://stitchery.clonedkitty.com",
            "webRoot": "${workspaceFolder}/stitchery-frontend/",
            "smartStep": true,
            "skipFiles": [
                "${workspaceFolder}/**/node_modules/**/*.js"
            ],
        },
        {
            "name": "[frontend] node attach",
            "presentation": {
                "hidden": true,
                "group": "frontend",
                "order": 2
            },
            "env": {
                "ENV2TS_INSPECT": "true"
            },
            "type": "node",
            "request": "attach",
            "port": 9230,
            "remoteRoot": "/app",
            "localRoot": "${workspaceFolder}/stitchery-frontend",
            "preLaunchTask": "[frontend] dev:debug",
            "autoAttachChildProcesses": false,
            "attachExistingChildren": false,
            "smartStep": true,
            "skipFiles": [
                "${workspaceFolder}/**/node_modules/**/*.js"
            ],
            "restart": true
        },
        {
            "name": "[api] run",
            "presentation": {
                "hidden": true,
                "group": "api",
                "order": 2
            },
            "type": "node",
            "request": "attach",
            "remoteRoot": "/app",
            "localRoot": "${workspaceFolder}/stitchery-api",
            "preLaunchTask": "[api] dev",
            "smartStep": true,
            "skipFiles": [
                "${workspaceFolder}/**/node_modules/**/*.js"
            ],
        },
    ],
    "compounds": [
        {
            "name": "[fullstack] debug",
            "presentation": {
                "group": "compounds",
                "order": 1
            },
            "configurations": [
                "[api] debug",
                "[frontend] browser"
            ],
        },
    ]
}
